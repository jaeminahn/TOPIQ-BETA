{
  "name": "@unigate/topik-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --pool=threads --maxWorkers=1 --exclude dist/**",
    "db:migrate": "tsx src/migrate.ts",
    "db:copy-to-supabase": "node scripts/copy-postgres-to-supabase.mjs",
    "images:compress": "tsx scripts/compress-listening-images.ts",
    "images:compress:production": "tsx scripts/compress-listening-images.ts --env-file .env.production",
    "admin:bootstrap": "tsx src/bootstrap-admin.ts"
  },
  "dependencies": {
    "@fastify/cors": "latest",
    "@fastify/helmet": "latest",
    "@fastify/multipart": "latest",
    "@fastify/rate-limit": "latest",
    "@supabase/supabase-js": "latest",
    "dotenv": "latest",
    "fastify": "latest",
    "google-auth-library": "latest",
    "pg": "latest",
    "sharp": "^0.35.5",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/pg": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
